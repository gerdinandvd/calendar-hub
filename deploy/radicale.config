[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /data/users
htpasswd_encryption = bcrypt

[rights]
# Both accounts may read and write on the Docker network.
# The internal account is not allowed through Caddy.
type = authenticated

[storage]
filesystem_folder = /data/collections

[headers]
Content-Security-Policy = default-src 'self'; object-src 'none'
