[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /data/users
htpasswd_encryption = bcrypt

[rights]
# Beide accounts mogen op het Docker-netwerk lezen en schrijven.
# Het interne account komt via Caddy niet door.
type = authenticated

[storage]
filesystem_folder = /data/collections

[headers]
Content-Security-Policy = default-src 'self'; object-src 'none'
