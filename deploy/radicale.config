[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /data/users
htpasswd_encryption = bcrypt

[rights]
# Owner may write private and webhook collections. ICS paths (/…/ics-…) are
# read-only for the owner. The internal hub account may write everywhere and
# is blocked at Caddy.
type = from_file
file = /config/rights

[storage]
filesystem_folder = /data/collections
# Hashing every event on write is slower than mtime and size, and the hash is only a cache.
use_mtime_and_size_for_item_cache = True

[headers]
Content-Security-Policy = default-src 'self'; object-src 'none'
